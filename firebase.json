          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "nbprojects-4a1a2",
          "configurations": {
            "android": "1:337878268199:android:03e3c48f4b5d304204d102",
            "ios": "1:337878268199:ios:79358dfd3cc41ae404d102",
            "macos": "1:337878268199:ios:79358dfd3cc41ae404d102",
