# ==============================================================================
# Hostinger Apache / LiteSpeed Configuration for Flutter Web Single Page App (SPA)
# ==============================================================================

# 1. Prevent Content Negotiation conflicts (ensures /admin doesn't clash)
Options -MultiViews

# 2. URL Rewriting for Single Page Application routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Explicit rewrite for /admin and /admin/ routes
  RewriteRule ^admin/?$ index.html [L,QSA]

  # Don't rewrite existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback for all other deep links and SPA routes
  RewriteRule ^ index.html [L,QSA]
</IfModule>

# 3. Proper MIME Types for Flutter Web assets
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType application/wasm .wasm
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
</IfModule>

# 4. Gzip Compression for accelerated loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/javascript \
                                application/json \
                                application/wasm \
                                text/css \
                                text/html \
                                text/plain \
                                text/xml \
                                image/svg+xml
</IfModule>

# 5. Cache Control: Always fetch latest index.html, cache static assets
<IfModule mod_headers.c>
  # Ensure index.html and version.json are never cached so releases update instantly
  <FilesMatch "(index\.html|version\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Cache static assets (images, fonts, scripts)
  <FilesMatch "\.(js|mjs|wasm|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|css)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
</IfModule>
